.s.o:
	$(AM_V_CCAS)$(CCASCOMPILE) -c -o $@ $<

.s.obj:
	$(AM_V_CCAS)$(CCASCOMPILE) -c -o $@ `$(CYGPATH_W) '$<'`

.s.lo:
	$(AM_V_CCAS)$(LTCCASCOMPILE) -c -o $@ $<

mostlyclean-libtool:
	-rm -f *.lo

clean-libtool:
	-rm -rf .libs _libs
	-rm -rf crt/.libs crt/_libs
	-rm -rf crt/lh/interface/cpu/.libs crt/lh/interface/cpu/_libs
	-rm -rf crt/lh/interface/cpu/arm/.libs crt/lh/interface/cpu/arm/_libs
	-rm -rf crt/lh/interface/cpu/arm64/.libs crt/lh/interface/cpu/arm64/_libs
	-rm -rf crt/lh/interface/cpu/intel/.libs crt/lh/interface/cpu/intel/_libs
	-rm -rf crt/lh/interface/cpu/mips/.libs crt/lh/interface/cpu/mips/_libs
	-rm -rf crt/lh/interface/hook/.libs crt/lh/interface/hook/_libs
	-rm -rf os/android/.libs os/android/_libs
	-rm -rf os/darwin/.libs os/darwin/_libs
	-rm -rf os/freebsd/.libs os/freebsd/_libs
	-rm -rf os/linux/.libs os/linux/_libs
	-rm -rf os/posix/.libs os/posix/_libs
	-rm -rf os/windows/.libs os/windows/_libs
	-rm -rf os/windows/InjLib/.libs os/windows/InjLib/_libs
	-rm -rf samples/dummy/.libs samples/dummy/_libs
	-rm -rf samples/netapi/.libs samples/netapi/_libs
	-rm -rf samples/pyloader/.libs samples/pyloader/_libs

distclean-libtool:
	-rm -f libtool config.lt
install-pkgconfigDATA: $(pkgconfig_DATA)
	@$(NORMAL_INSTALL)
	@list='$(pkgconfig_DATA)'; test -n "$(pkgconfigdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(pkgconfigdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(pkgconfigdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(pkgconfigdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(pkgconfigdir)" || exit $$?; \
	done

uninstall-pkgconfigDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(pkgconfig_DATA)'; test -n "$(pkgconfigdir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(pkgconfigdir)'; $(am__uninstall_files_from_dir)
install-arch_includeHEADERS: $(arch_include_HEADERS)
	@$(NORMAL_INSTALL)
	@list='$(arch_include_HEADERS)'; test -n "$(arch_includedir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(arch_includedir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(arch_includedir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_HEADER) $$files '$(DESTDIR)$(arch_includedir)'"; \
	  $(INSTALL_HEADER) $$files "$(DESTDIR)$(arch_includedir)" || exit $$?; \
	done

uninstall-arch_includeHEADERS:
	@$(NORMAL_UNINSTALL)
	@list='$(arch_include_HEADERS)'; test -n "$(arch_includedir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(arch_includedir)'; $(am__uninstall_files_from_dir)
